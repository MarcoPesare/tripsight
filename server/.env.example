PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Vuoto in sviluppo (si usa un segreto di sviluppo). In produzione: almeno 32 caratteri casuali.
JWT_SECRET=
# Dati volo per numero e data. mock = voli fittizi in src/data/mock-flights.json, nessuna chiamata esterna.
# airlabs = API reale (serve AIRLABS_API_KEY); le risposte restano in cache su disco (DATA_DIR/cache/flights).
FLIGHT_PROVIDER=mock
AIRLABS_API_KEY=
# Tariffe di mercato per tratta. mock = tariffe sintetiche; travelpayouts = API reale (serve TRAVELPAYOUTS_TOKEN,
# da https://www.travelpayouts.com → Profilo → API token).
FARE_PROVIDER=mock
TRAVELPAYOUTS_TOKEN=
# Email di recupero password (https://resend.com). Senza chiave, in sviluppo il link viene stampato nel log.
RESEND_API_KEY=
MAIL_FROM=Tripsight <onboarding@resend.dev>
# In produzione: NODE_ENV=production e JWT_SECRET di almeno 32 caratteri casuali
NODE_ENV=development
